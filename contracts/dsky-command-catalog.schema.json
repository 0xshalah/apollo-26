{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://apollo-26.local/schemas/dsky-command-catalog-v1.json",
  "title": "Apollo-26 DSKY command catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "catalog_id", "catalog_version", "agc_subset_id", "description", "keys", "field_encodings", "segments", "commands", "criticality", "authorization", "preconditions", "execution", "plan_digest"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "catalog_id": { "const": "apollo26-dsky-command-catalog" },
    "catalog_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "agc_subset_id": { "type": "string" },
    "description": { "type": "string" },
    "keys": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/key" } },
    "field_encodings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["SIGNED_5", "DIGITS_2"],
      "properties": {
        "SIGNED_5": { "$ref": "#/$defs/encoding" },
        "DIGITS_2": { "$ref": "#/$defs/encoding" }
      }
    },
    "segments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/token" } }
    },
    "commands": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "summary", "match", "require_zero", "segments", "postcondition"],
        "properties": {
          "id": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
          "summary": { "type": "string" },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "required": ["verb", "noun", "program"],
            "properties": {
              "verb": { "type": "integer", "minimum": 0, "maximum": 99 },
              "noun": { "type": "integer", "minimum": 0, "maximum": 99 },
              "program": { "type": "integer", "minimum": 0, "maximum": 99 }
            }
          },
          "require_zero": { "type": "array", "uniqueItems": true, "items": { "$ref": "#/$defs/payloadField" } },
          "segments": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "postcondition": {
            "type": "object",
            "additionalProperties": false,
            "required": ["program", "verb", "noun", "registers", "required_clear_lamps"],
            "properties": {
              "program": { "oneOf": [{ "enum": [0, 40] }, { "const": "UNCHANGED" }] },
              "verb": { "type": "integer", "minimum": 0, "maximum": 99 },
              "noun": { "oneOf": [{ "type": "integer", "minimum": 0, "maximum": 99 }, { "const": "UNCHANGED" }] },
              "registers": {
                "oneOf": [
                  { "const": "UNCHANGED" },
                  {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["r1", "r2", "r3"],
                    "properties": {
                      "r1": { "$ref": "#/$defs/payloadField" },
                      "r2": { "$ref": "#/$defs/payloadField" },
                      "r3": { "$ref": "#/$defs/payloadField" }
                    }
                  }
                ]
              },
              "required_clear_lamps": { "type": "array", "items": { "enum": ["opr_err", "key_rel"] } }
            }
          }
        }
      }
    },
    "criticality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p40_critical_delta_v_threshold_tenths_fps", "frame_critical_flag", "rules"],
      "properties": {
        "p40_critical_delta_v_threshold_tenths_fps": { "type": "integer", "minimum": 0 },
        "frame_critical_flag": { "const": "ADD_ONLY" },
        "rules": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "description"],
            "properties": {
              "id": { "enum": ["V37_WHILE_P40", "V34_WHILE_P40", "NONZERO_P40_ACTIVATION", "FRAME_CRITICAL_FLAG"] },
              "description": { "type": "string" }
            }
          }
        }
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["auth_ref_must_equal_command_seq", "hold_expiry_ms", "expiry_clock", "single_use"],
      "properties": {
        "auth_ref_must_equal_command_seq": { "const": true },
        "hold_expiry_ms": { "type": "integer", "minimum": 1 },
        "expiry_clock": { "type": "string" },
        "single_use": { "const": true }
      }
    },
    "preconditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "input_state", "pending_entry", "key_rel", "opr_err"],
      "properties": {
        "description": { "type": "string" },
        "input_state": { "const": "IDLE" },
        "pending_entry": { "type": "null" },
        "key_rel": { "const": false },
        "opr_err": { "const": false }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_key_cadence_ms", "inspection_max_age_ms"],
      "properties": {
        "min_key_cadence_ms": { "type": "integer", "minimum": 100 },
        "inspection_max_age_ms": { "type": "integer", "minimum": 1 }
      }
    },
    "plan_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "input"],
      "properties": { "algorithm": { "const": "SHA-256" }, "input": { "type": "string" } }
    }
  },
  "$defs": {
    "key": { "enum": ["VERB", "NOUN", "DIGIT_0", "DIGIT_1", "DIGIT_2", "DIGIT_3", "DIGIT_4", "DIGIT_5", "DIGIT_6", "DIGIT_7", "DIGIT_8", "DIGIT_9", "PLUS", "MINUS", "ENTR", "PRO", "CLR", "RSET", "KEY_REL"] },
    "payloadField": { "enum": ["program", "r1_centidegrees", "r2_centidegrees", "delta_v_tenths_fps"] },
    "encoding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "min", "max"],
      "properties": { "description": { "type": "string" }, "min": { "type": "integer" }, "max": { "type": "integer" } }
    },
    "token": {
      "oneOf": [
        { "$ref": "#/$defs/key" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field", "encoding"],
          "properties": { "field": { "$ref": "#/$defs/payloadField" }, "encoding": { "enum": ["SIGNED_5", "DIGITS_2"] } }
        }
      ]
    }
  }
}
